{
  "version": "0.1",
  "role": "artales_symbol_pen_drop",
  "input_image": "brand/artales/references/extracted/symbol-pen-drop.source-crop.png",
  "output_dir": "tools/brand/vectorize-reference/output/artales-symbol-v0.1",
  "segmentation": {
    "mode": "background_distance",
    "background_color": [15, 19, 22],
    "target_color": [220, 166, 69],
    "tolerance": 42,
    "alpha_threshold": 1
  },
  "cleanup": {
    "open_radius": 1,
    "close_radius": 1
  },
  "trace": {
    "mode": "foreground",
    "fill_color": "#DCA645",
    "background": "transparent",
    "potrace": {
      "turdsize": 2,
      "alphamax": 1.0,
      "opttolerance": 0.2
    }
  },
  "trace_matrix": [
    {
      "id": "current",
      "label": "Current conservative",
      "potrace": {"turdsize": 2, "alphamax": 1.0, "opttolerance": 0.2}
    },
    {
      "id": "smoother",
      "label": "Smoother",
      "potrace": {"turdsize": 2, "alphamax": 1.1, "opttolerance": 0.4}
    },
    {
      "id": "cleaner",
      "label": "Cleaner",
      "potrace": {"turdsize": 3, "alphamax": 1.0, "opttolerance": 0.3}
    },
    {
      "id": "stricter",
      "label": "Stricter",
      "potrace": {"turdsize": 1, "alphamax": 0.8, "opttolerance": 0.15}
    }
  ],
  "outputs": {
    "mask": "symbol-mask.png",
    "cleaned_mask": "symbol-mask-cleaned.png",
    "trace": "symbol-trace-candidate.svg",
    "overlay": "symbol-overlay.png",
    "review_board": "symbol-review-board.png",
    "report": "symbol-report.json"
  },
  "notes": "Candidate thresholds derived from documented reference samples. Outputs are diagnostics only and require visual review.",
  "approval_state": "not_run"
}
